<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.StudentAutomaticScheduler"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Buttons -->
        <item name="colorPrimary">@color/button_bg</item>
        <item name="colorOnPrimary">@color/button_text</item>

        <!-- Optional default background -->
        <!-- <item name="android:windowBackground">@drawable/bg_main</item> -->

    </style>

    <style name="Theme.StudentAutomaticScheduler"
        parent="Base.Theme.StudentAutomaticScheduler">
        <item name="materialButtonStyle">@style/RoundedButtonStyle</item>
        <item name="textInputStyle">@style/RoundedTextInputLayout</item>
        <item name="alertDialogTheme">@style/RoundedDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/RoundedDialogTheme</item>
    </style>

    <style name="RoundedDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/DialogShapeAppearance</item>
        <item name="colorAccent">@color/link_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!-- Button styles inside dialog -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogShapeAppearance" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/link_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RoundedButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearanceOverlay">@style/ButtonShapeRound</item>
    </style>

    <style name="RoundedTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ButtonShapeRound</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="ButtonShapeRound" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="CalendarViewTheme" parent="Theme.StudentAutomaticScheduler">

        <item name="colorPrimary">@color/link_blue</item>


        <item name="android:dateTextAppearance">@style/CalendarDateStyle</item>
        <item name="android:weekDayTextAppearance">@style/CalendarDateStyle</item>
    </style>


    <style name="CalendarDateStyle" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalendarArrowTheme" parent="Theme.StudentAutomaticScheduler">
        <item name="colorControlNormal">@color/text_primary</item>
    </style>

</resources>