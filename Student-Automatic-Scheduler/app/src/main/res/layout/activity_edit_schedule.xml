<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="16dp"
    android:paddingBottom="24dp"

    android:background="@drawable/bg_dashboard">

    <!-- WATERMARK -->
    <ImageView
        android:id="@+id/imgWatermark"

        android:layout_width="380dp"
        android:layout_height="280dp"

        android:alpha="0.35"
        android:scaleType="fitCenter"
        android:src="@drawable/bulldog"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- HEADER -->
    <TextView
        android:id="@+id/tvTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Verify Parsed Data"
        android:textColor="@color/text_primary"

        android:textSize="28sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/tvSubtitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:text="Review and edit your detected schedule"
        android:textColor="@color/text_secondary"

        android:textSize="14sp"

        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- MAIN CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainCard"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"

        app:cardBackgroundColor="@color/surface_variant"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"

        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnSaveAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEditSchedule"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:padding="14dp"
            android:clipToPadding="false"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- ADD BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRow"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_margin="18dp"

        android:contentDescription="Add Class"

        android:src="@android:drawable/ic_input_add"

        app:backgroundTint="@color/button_bg"
        app:tint="@android:color/white"

        app:layout_constraintBottom_toTopOf="@id/btnSaveAll"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SAVE BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAll"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginBottom="18dp"

        android:text="Save to Schedule"
        android:textAllCaps="false"

        android:textSize="16sp"
        android:textStyle="bold"

        android:paddingVertical="14dp"

        android:textColor="@color/button_text"

        app:backgroundTint="@color/button_bg"
        app:cornerRadius="18dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>